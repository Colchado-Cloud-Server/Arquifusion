# Plantilla de configuración propuesta. Copiar a .env y completar localmente.
# Los handlers y la infraestructura todavía no están implementados.
# Usar el perfil AWS autorizado; no guardar credenciales temporales aquí.
STAGE=dev
AWS_PROFILE=
AWS_REGION=

# Roles y bucket de despliegue aprobados en Learner Lab
LAMBDA_ROLE_ARN=
SFN_ROLE_ARN=
EVENTS_START_SFN_ROLE_ARN=
SCHEDULER_ROLE_ARN=
DEPLOYMENT_BUCKET=

# Identidad de personas
FIREBASE_PROJECT_ID=

# Referencias a secretos; nunca pegar los valores de los secretos
SIMULATOR_SECRET_ID=/af/dev/simulator-token
GCP_CREDENTIALS_SECRET_ID=

# Ingesta, almacenamiento y eventos
TELEMETRY_POST_URL=
TELEMETRY_QUEUE_URL=
TELEMETRY_BUCKET=
EVENT_BUS_NAME=
MAINTENANCE_WORKFLOW_ARN=

# Tablas
OPERATIONS_TABLE=
MACHINE_MODELS_TABLE=
MACHINES_TABLE=
EVENT_DEDUP_TABLE=
USERS_TABLE=
INCIDENTS_TABLE=
ACTIVE_INCIDENTS_TABLE=
MAINTENANCE_EVENTS_TABLE=
TECHNICIANS_TABLE=
PARTS_TABLE=
PART_RESERVATIONS_TABLE=
NOTIFICATIONS_TABLE=
ANALYTICS_TABLE=

# Proyecto BigQuery separado del proyecto Firebase cuando corresponda
GCP_PROJECT_ID=
BQ_DATASET=arquifusion_dev
BQ_LOCATION=
