# Copiar a .env en CloudShell y completar con los recursos autorizados.
# CloudShell usa su sesión; no copiar claves AWS ni valores de secretos aquí.
STAGE=dev
AWS_REGION=us-east-1
EXPECTED_AWS_ACCOUNT_ID=
# Sólo para un perfil nombrado, si el entorno lo necesita:
# AWS_PROFILE=academy

# Roles y bucket de despliegue aprobados en Learner Lab
LAMBDA_ROLE_ARN=
SFN_ROLE_ARN=
EVENTS_START_SFN_ROLE_ARN=
SCHEDULER_ROLE_ARN=
DEPLOYMENT_BUCKET=
# Origen exacto HTTPS de Pages, sin slash final ni comodines.
PAGES_ORIGIN=
# Overrides opcionales del rol Lambda compartido:
# SIMULATOR_ROLE_ARN=arn:aws:iam::<account>:role/<approved-role>
# INGEST_ROLE_ARN=arn:aws:iam::<account>:role/<approved-role>
ENABLE_SCHEDULER=false
ENABLE_ALARMS=true
# Activar el consumidor sólo después de cargar y verificar catálogos.
ENABLE_TELEMETRY_CONSUMER=false

# Identidad de personas
FIREBASE_PROJECT_ID=
DEMO_OPERATION_ID=op-demo
DEMO_SEED_ENABLED=false
DEMO_USER_UIDS_JSON={}

# Referencias a secretos; nunca pegar los valores de los secretos
SIMULATOR_SECRET_ID=/af/dev/simulator-token
SECRET_STORE=ssm
GCP_CREDENTIALS_SECRET_ID=

# Ingesta, almacenamiento y eventos
# Stack outputs provide API URL, workflow ARNs, queue URLs and telemetry bucket.
# Existing resources: leave these empty to let this stack create its resources.
EXISTING_TELEMETRY_BUCKET=
EXISTING_TELEMETRY_QUEUE_ARN=
EXISTING_TELEMETRY_QUEUE_URL=
EXISTING_TELEMETRY_DLQ_ARN=
EXISTING_TELEMETRY_DLQ_URL=

# Tablas: por defecto se crean af-<stage>-t-*. No definir overrides vacíos.
# Para reutilizar TODAS, USE_EXISTING_TABLES=true y definir los 13 nombres.
USE_EXISTING_TABLES=false
# Para reutilizar sólo una: USE_EXISTING_USERS_TABLE=true y USERS_TABLE=<nombre>.
# El mismo patrón USE_EXISTING_<VARIABLE> aplica a cada tabla:
# OPERATIONS_TABLE=af-dev-t-operations
# MACHINE_MODELS_TABLE=af-dev-t-machine-models
# MACHINES_TABLE=af-dev-t-machines
# EVENT_DEDUP_TABLE=af-dev-t-event-dedup
# USERS_TABLE=af-dev-t-users
# INCIDENTS_TABLE=af-dev-t-incidents
# ACTIVE_INCIDENTS_TABLE=af-dev-t-active-incidents
# MAINTENANCE_EVENTS_TABLE=af-dev-t-maintenance-events
# TECHNICIANS_TABLE=af-dev-t-technicians
# PARTS_TABLE=af-dev-t-parts
# PART_RESERVATIONS_TABLE=af-dev-t-part-reservations
# NOTIFICATIONS_TABLE=af-dev-t-notifications
# ANALYTICS_TABLE=af-dev-t-analytics

# Proyecto BigQuery separado del proyecto Firebase cuando corresponda
GCP_PROJECT_ID=
BQ_DATASET=arquifusion_dev
BQ_LOCATION=US
